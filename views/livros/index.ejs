<%- include('../partials/header') %>
<div class="titulo-linha"><h1>Livros</h1><a class="btn" href="/livros/novo">Novo livro</a></div>
<% if (!livros.length) { %>
  <p class="vazio">Nenhum livro cadastrado. <a href="/autores">Cadastre um autor</a> e depois adicione o primeiro livro.</p>
<% } else { %>
<table>
  <thead><tr><th>Título</th><th>Autor</th><th>Ano</th><th></th></tr></thead>
  <tbody>
  <% livros.forEach(l => { %>
    <tr>
      <td><%= l.titulo %></td><td><%= l.autor_nome %></td><td><%= l.ano_publicacao || '—' %></td>
      <td class="acoes">
        <a href="/livros/<%= l.id %>/editar">Editar</a>
        <form method="post" action="/livros/<%= l.id %>/excluir" onsubmit="return confirm('Excluir este livro?')">
          <button class="link perigo">Excluir</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } %>
<%- include('../partials/footer') %>
